# Q-PRIME — OPTIONAL configuration.
#
# You do NOT need this file. `docker compose up -d --build` starts the whole
# stack with the defaults below already applied. Copy it to `.env` only to point
# the cloud tier at real AWS, remap a host port, or enable the local LLM.

# ------------------------------- host ports ----------------------------------
# Change these if something else on your machine already owns the port.
QPRIME_WEB_PORT=3000
QPRIME_ANALYSIS_PORT=5005
QPRIME_NLP_PORT=5500
PRESTO_PORT=8085
MONGODB_PORT=27017
EDGEX_MQTT_PORT=1884
EDGEX_DATA_PORT=59880
EDGEX_METADATA_PORT=59881
EDGEX_COMMAND_PORT=59882
EDGEX_KEEPER_PORT=59890
EDGEX_DEVICE_REST_PORT=59986
EDGEX_QPRIME_EXPORT_PORT=59704
EDGEX_UI_PORT=4000
OLLAMA_PORT=11434

# ----------------------------- generated data modes --------------------------
# Simulator and Sample EdgeX Feed are OFF by default. Start one from /qprime.
# This only controls the rate of the user-started Sample EdgeX Feed.
QPRIME_SAMPLE_RATE_PER_MIN=60

# --------------------------------- Querying ---------------------------------
CONTINUUM_DB="qprime"
CONTINUUM_TABLE="continuum"
NEXT_PUBLIC_SQL_TABLE_NAME="qprime.continuum"
EPOCH_SCALE="s"
LOCAL_TZ_NAME="Australia/Sydney"

# Optional web mount path. Empty serves the application at http://localhost:3000/.
NEXT_PUBLIC_BASE_PATH=""

# --------------------------------- AWS Cloud --------------------------------
# Nothing to set here. Configure AWS Cloud placement from the Q-PRIME dashboard;
# static credentials are encrypted in MongoDB and a durable Docker volume
# retains the encryption key. Without it, Cloud decisions are retained locally.

# -------------------------------- local LLM ---------------------------------
#To use a local model, set both flags to 1 AND start the profile:
#     docker compose --profile llm up -d ollama
#     docker compose --profile llm exec ollama ollama pull qwen2.5:7b-instruct-q4_K_M
USE_LLM_SQL=
USE_LLM_SUMMARY=
OLLAMA_HOST="http://ollama:11434"
MODEL="qwen2.5:7b-instruct-q4_K_M"
